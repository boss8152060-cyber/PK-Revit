<TextBlock x:Name="tb_info" FontSize="12" TextWrapping="Wrap"
           Foreground="{StaticResource TxtDim}"/>
<CheckBox x:Name="cb_same" Content="ใส่ให้เสาชื่อ type เดียวกันทั้งอาคาร" IsChecked="False"/>
<CheckBox x:Name="cb_replace" Content="แทนที่เหล็ก REVOTECH เดิมของเสาเหล่านี้" IsChecked="True"/>

<TextBlock Text="เหล็กยืน" FontSize="11.5" Foreground="{StaticResource Accent}"
           FontWeight="SemiBold" Margin="0,14,0,6"/>
<Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="จำนวน (เส้น)" VerticalAlignment="Center"/>
    <ComboBox x:Name="cmb_n" Grid.Row="0" Grid.Column="1" Height="26" Margin="0,0,0,6"/>
    <TextBlock Grid.Row="1" Text="ขนาด" VerticalAlignment="Center"/>
    <ComboBox x:Name="cmb_main" Grid.Row="1" Grid.Column="1" Height="26" Margin="0,0,0,6"/>
    <TextBlock Grid.Row="2" Text="ต่อทาบเหนือเสา (× d)" VerticalAlignment="Center"/>
    <TextBox x:Name="tb_lap" Grid.Row="2" Grid.Column="1" Text="40" HorizontalAlignment="Left"/>
</Grid>
<TextBlock Text="ปลายล่างเสมอตัวเสา, ปลายบนยื่นเหนือเสาตามระยะทาบ (ต่อทาบที่รอยต่อชั้น) — โหมดวิ่งเดียวถึงชั้นบนสุดยังไม่รองรับ"
           FontSize="10" Foreground="{StaticResource TxtDim}" TextWrapping="Wrap" Margin="0,4,0,0"/>

<TextBlock Text="เหล็กปลอก" FontSize="11.5" Foreground="{StaticResource Accent}"
           FontWeight="SemiBold" Margin="0,14,0,6"/>
<Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="ขนาด" VerticalAlignment="Center"/>
    <ComboBox x:Name="cmb_tie" Grid.Row="0" Grid.Column="1" Height="26" Margin="0,0,0,6"/>
    <TextBlock Grid.Row="1" Text="ระยะเรียง กลางเสา (ม.)" VerticalAlignment="Center"/>
    <TextBox x:Name="tb_sp_mid" Grid.Row="1" Grid.Column="1" Text="0.15" HorizontalAlignment="Left" Margin="0,0,0,6"/>
    <TextBlock Grid.Row="2" Text="ระยะเรียง ปลายเสา (ม.)" VerticalAlignment="Center"/>
    <TextBox x:Name="tb_sp_end" Grid.Row="2" Grid.Column="1" Text="0.10" HorizontalAlignment="Left" Margin="0,0,0,6"/>
    <TextBlock Grid.Row="3" Text="ความยาวโซนปลาย (ม.)" VerticalAlignment="Center"/>
    <TextBox x:Name="tb_end_len" Grid.Row="3" Grid.Column="1" Text="0.60" HorizontalAlignment="Left"/>
</Grid>

<TextBlock Text="ระยะหุ้ม" FontSize="11.5" Foreground="{StaticResource Accent}"
           FontWeight="SemiBold" Margin="0,14,0,6"/>
<StackPanel Orientation="Horizontal">
    <TextBox x:Name="tb_cover" Text="0.025"/>
    <TextBlock Text="  ม. (ถึงผิวเหล็กปลอก)" VerticalAlignment="Center" Foreground="{StaticResource TxtDim}"/>
</StackPanel>

<TextBlock Text="ด่านตรวจก่อนสร้าง" FontSize="11.5" Foreground="{StaticResource Accent}"
           FontWeight="SemiBold" Margin="0,14,0,6"/>
<TextBlock x:Name="tb_check" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,4"/>
