<TextBlock x:Name="tb_info" FontSize="12" TextWrapping="Wrap"
           Foreground="{StaticResource TxtDim}"/>

<TextBlock Text="ขอบเขต" FontSize="11.5" Foreground="{StaticResource Accent}"
           FontWeight="SemiBold" Margin="0,12,0,6"/>
<RadioButton x:Name="rb_all" Content="ทั้งโมเดล" IsChecked="True" GroupName="scope"/>
<RadioButton x:Name="rb_sel" Content="เฉพาะเหล็กที่เลือก (หรือเหล็กของ element ที่เลือก)" GroupName="scope"/>
<StackPanel Orientation="Horizontal" Margin="0,6,0,0">
    <CheckBox x:Name="cb_column" Content="เสา" IsChecked="True" Margin="0,0,12,0"/>
    <CheckBox x:Name="cb_beam" Content="คาน" IsChecked="True" Margin="0,0,12,0"/>
    <CheckBox x:Name="cb_footing" Content="ฐานราก" IsChecked="True" Margin="0,0,12,0"/>
    <CheckBox x:Name="cb_slab" Content="พื้น" IsChecked="True" Margin="0,0,12,0"/>
    <CheckBox x:Name="cb_stair" Content="บันได" IsChecked="True"/>
</StackPanel>

<TextBlock Text="แผนตัด" FontSize="11.5" Foreground="{StaticResource Accent}"
           FontWeight="SemiBold" Margin="0,14,0,6"/>
<Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="170"/><ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="ท่อนสต็อก (ม.)" VerticalAlignment="Center"/>
    <ComboBox x:Name="cmb_stock" Grid.Column="1" Height="26" Margin="0,0,0,6"/>
    <TextBlock Grid.Row="1" Text="เผื่อรอยตัด (มม./การตัด)" VerticalAlignment="Center"/>
    <TextBox x:Name="tb_kerf" Grid.Row="1" Grid.Column="1" Text="3"/>
</Grid>
<TextBlock Text="น้ำหนัก kg/m ใช้ค่าตารางเหล็กไทยตั้งต้น (RB9 0.499 · DB12 0.888 · DB16 1.578 ...) — ต้องยืนยันก่อนใช้สั่งซื้อ"
           FontSize="10" Foreground="{StaticResource TxtDim}" TextWrapping="Wrap" Margin="0,4,0,0"/>

<TextBlock Text="ผลลัพธ์" FontSize="11.5" Foreground="{StaticResource Accent}"
           FontWeight="SemiBold" Margin="0,14,0,6"/>
<CheckBox x:Name="cb_sheet" Content="สร้างชีต Revit + ตารางเหล็ก" IsChecked="True"/>
<Grid Margin="0,6,0,0">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="170"/><ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <TextBlock Text="Title Block" VerticalAlignment="Center"/>
    <ComboBox x:Name="cmb_tb" Grid.Column="1" Height="26"/>
</Grid>
<CheckBox x:Name="cb_replace" Content="แทนที่ชีต/ตารางบาร์คัทชุดเดิม" IsChecked="True" Margin="0,6,0,0"/>
<CheckBox x:Name="cb_mark" Content="เขียนเลขบาร์ลงพารามิเตอร์ Mark ของเหล็ก (ใช้กับตาราง Revit)" IsChecked="True"/>
<CheckBox x:Name="cb_excel" Content="ส่งออกไฟล์" IsChecked="True" Margin="0,6,0,0"/>
<Grid Margin="0,6,0,0">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="170"/><ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <TextBlock Text="รูปแบบไฟล์" VerticalAlignment="Center"/>
    <ComboBox x:Name="cmb_fmt" Grid.Column="1" Height="26"/>
</Grid>
<TextBlock x:Name="tb_warn" FontSize="11" Foreground="#FF6B2C" TextWrapping="Wrap" Margin="0,8,0,0"/>
