<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roof Master" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#FF6B2C"/>
        <SolidColorBrush x:Key="Card" Color="#1B1D22"/>
        <SolidColorBrush x:Key="Field" Color="#26282E"/>
        <SolidColorBrush x:Key="Line" Color="#33363E"/>
        <SolidColorBrush x:Key="TxtMain" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="TxtDim" Color="#9A9DA6"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TxtMain}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TxtMain}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="18" Height="18" CornerRadius="4"
                                    BorderBrush="#5A5D66" BorderThickness="1.5"
                                    Background="{StaticResource Field}"
                                    VerticalAlignment="Center">
                                <Path x:Name="check" Data="M 3,9 L 7,13 L 14,4"
                                      Stroke="White" StrokeThickness="2.2"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0"
                                              VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background"
                                        Value="{StaticResource Accent}"/>
                                <Setter TargetName="box" Property="BorderBrush"
                                        Value="{StaticResource Accent}"/>
                                <Setter TargetName="check" Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Field}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="76"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="6,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush"
                                        Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Card}" CornerRadius="14"
            BorderBrush="#2B2E36" BorderThickness="1" Padding="0">
        <StackPanel Width="430">
            <!-- title bar -->
            <Grid x:Name="title_bar" Background="Transparent" Margin="24,18,16,0">
                <StackPanel>
                    <TextBlock FontSize="20" FontWeight="Bold">
                        <Run Text="ROOF " Foreground="#F2F2F2"/><Run Text="MASTER"
                             Foreground="#FF6B2C"/>
                    </TextBlock>
                    <TextBlock Text="สร้างโครงหลังคาทั้งชุดในคลิกเดียว — REVOTECH"
                               FontSize="11.5" Foreground="{StaticResource TxtDim}"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="close_btn" Content="✕" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Width="28" Height="28"
                        Background="Transparent" Foreground="#9A9DA6"
                        BorderThickness="0" FontSize="13" Cursor="Hand"/>
            </Grid>

            <Border Height="1" Background="{StaticResource Line}" Margin="24,14,24,0"/>

            <!-- steps -->
            <StackPanel Margin="24,12,24,0">
                <TextBlock Text="ขั้นตอน (เรียงตามลำดับที่รันจริง)" FontSize="11.5"
                           Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                <CheckBox x:Name="cb_all" Content="ทั้งหมด (5 ขั้น)"
                          IsChecked="True" FontWeight="SemiBold"/>
                <CheckBox x:Name="cb_hip" Content="1)  ตะเข้สัน + อกไก่   (Hip Ridge Gen)"
                          IsChecked="True"/>
                <CheckBox x:Name="cb_purlin" Content="2)  แป   (Purlin Gen)"
                          IsChecked="True"/>
                <CheckBox x:Name="cb_valley" Content="3)  รางน้ำ + ตะเข้ราง   (Valley Gen)"
                          IsChecked="True"/>
                <CheckBox x:Name="cb_rafter" Content="4)  จันทัน   (Rafter Gen)"
                          IsChecked="True"/>
                <CheckBox x:Name="cb_dang" Content="5)  ดั้ง (Dang Gen)"
                          IsChecked="True"/>
            </StackPanel>

            <Border Height="1" Background="{StaticResource Line}" Margin="24,16,24,0"/>

            <!-- values -->
            <StackPanel Margin="24,12,24,0">
                <TextBlock Text="ระยะ (มม.)" FontSize="11.5"
                           Foreground="{StaticResource Accent}" FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12"
                                VerticalAlignment="Center">
                        <TextBlock Text="ระยะห่างแป" FontSize="13"/>
                        <TextBlock Text="ห่างกันแถวละเท่าไหร่ (วัดตามลาด)"
                                   FontSize="10" Foreground="{StaticResource TxtDim}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox x:Name="tb_purlin" Grid.Row="0" Grid.Column="1"
                             Text="340" VerticalAlignment="Center" Margin="0,0,0,12"/>

                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,8,12"
                                VerticalAlignment="Center">
                        <TextBlock Text="ระยะห่างจันทัน" FontSize="13"/>
                        <TextBlock Text="ห่างกันตัวละเท่าไหร่"
                                   FontSize="10" Foreground="{StaticResource TxtDim}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox x:Name="tb_rafter" Grid.Row="0" Grid.Column="4"
                             Text="1000" VerticalAlignment="Center" Margin="0,0,0,12"/>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,4"
                                VerticalAlignment="Center">
                        <TextBlock Text="แปแถวล่างสุด" FontSize="13"/>
                        <TextBlock Text="ห่างจากขอบชายคาขึ้นมาเท่าไหร่"
                                   FontSize="10" Foreground="{StaticResource TxtDim}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox x:Name="tb_eave" Grid.Row="1" Grid.Column="1"
                             Text="340" VerticalAlignment="Center" Margin="0,0,0,12"/>

                    <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,8,4"
                                VerticalAlignment="Center">
                        <TextBlock Text="แปแถวบนสุด" FontSize="13"/>
                        <TextBlock Text="ห่างจากสันหลังคาลงมาเท่าไหร่"
                                   FontSize="10" Foreground="{StaticResource TxtDim}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox x:Name="tb_ridge" Grid.Row="1" Grid.Column="4"
                             Text="50" VerticalAlignment="Center" Margin="0,0,0,12"/>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,4"
                                VerticalAlignment="Center">
                        <TextBlock Text="ความสูงดั้ง (สำรอง)" FontSize="13"/>
                        <TextBlock Text="ใช้เมื่อหาโครงรับด้านล่างไม่เจอ"
                                   FontSize="10" Foreground="{StaticResource TxtDim}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox x:Name="tb_dang" Grid.Row="2" Grid.Column="1"
                             Text="1000" VerticalAlignment="Center" Margin="0,0,0,4"/>
                </Grid>
            </StackPanel>

            <Border Height="1" Background="{StaticResource Line}" Margin="24,12,24,0"/>

            <!-- family check -->
            <StackPanel Margin="24,12,24,0">
                <TextBlock Text="เลือก type เหล็กจากโปรเจกต์" FontSize="11.5"
                           Foreground="{StaticResource Accent}" FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="ตะเข้สัน" FontSize="12.5" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cmb_hip" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" Height="26"/>
                    <TextBlock Grid.Row="1" Text="อกไก่" FontSize="12.5" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cmb_ridge" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Height="26"/>
                    <TextBlock Grid.Row="2" Text="แป" FontSize="12.5" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cmb_purlin" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" Height="26"/>
                    <TextBlock Grid.Row="3" Text="จันทัน" FontSize="12.5" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cmb_rafter" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" Height="26"/>
                    <TextBlock Grid.Row="4" Text="รางน้ำ" FontSize="12.5" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cmb_gutter" Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" Height="26"/>
                    <TextBlock Grid.Row="5" Text="ดั้ง" FontSize="12.5" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cmb_dang" Grid.Row="5" Grid.Column="1" Margin="0,0,0,6" Height="26"/>
                </Grid>
                <TextBlock Text="ระบบเลือกให้เองจากชื่อที่มีคำนั้น (ตะเข้สัน, อกไก่, แป, จันทัน, รางน้ำ, ดั้ง) — เปลี่ยนได้ ถ้าเลือก “ไม่ระบุ” จะใช้การค้นหาตามชื่อแบบเดิม (ตะเข้ราง/รางน้ำ ไม่มีก็ได้ — สร้างให้อัตโนมัติ)"
                           FontSize="10" Foreground="{StaticResource TxtDim}"
                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                <TextBlock Text="เลือกหลังคาก่อนกด  •  Ctrl+Z ครั้งเดียวย้อนทั้งชุด"
                           FontSize="10" Foreground="{StaticResource TxtDim}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- run -->
            <Button x:Name="run_btn" Margin="24,16,24,22" Height="42"
                    Cursor="Hand" FontSize="14.5" FontWeight="Bold"
                    Foreground="White" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{StaticResource Accent}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="#FF8449"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="#E55A1E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="🏠  สร้างโครงหลังคา" Foreground="White"/>
            </Button>
        </StackPanel>
    </Border>
</Window>
