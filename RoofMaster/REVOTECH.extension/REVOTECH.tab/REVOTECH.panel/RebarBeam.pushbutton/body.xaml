<TextBlock Text="เหล็กข้าง (ต่อด้าน)" FontSize="11.5" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,14,0,6"/>
<Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <TextBlock Text="จำนวน × ขนาด" VerticalAlignment="Center"/>
  <ComboBox x:Name="cmb_side_n" Grid.Column="1" Height="26" Margin="0,0,6,0"/>
  <ComboBox x:Name="cmb_side_d" Grid.Column="2" Height="26"/></Grid>
<TextBlock Text="เหล็กปลอก (ปลาย 135°)" FontSize="11.5" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,14,0,6"/>
<Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="ขนาด" VerticalAlignment="Center"/><ComboBox x:Name="cmb_tie" Grid.Column="1" Height="26"/></Grid>
<Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <TextBlock Text="ระยะเรียง กลางช่วง (ม.)" VerticalAlignment="Center"/>
  <TextBox x:Name="tb_sp_mid" Grid.Column="1" Text="0.20" HorizontalAlignment="Left"/></Grid>
<Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <TextBlock Text="ระยะเรียง โซนปลาย (ม.)" VerticalAlignment="Center"/>
  <TextBox x:Name="tb_sp_end" Grid.Column="1" Text="0.10" HorizontalAlignment="Left"/></Grid>
<Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <TextBlock Text="ความยาวโซนปลาย (ม.)" VerticalAlignment="Center"/>
  <TextBox x:Name="tb_end_len" Grid.Column="1" Text="0.80" HorizontalAlignment="Left"/></Grid>
<TextBlock Text="ปลายเหล็กงอ 90°" FontSize="11.5" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,14,0,6"/>
<Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Text="ความยาวขางอ" VerticalAlignment="Center"/><ComboBox x:Name="cmb_hook" Grid.Column="1" Height="26" Margin="0,0,6,0"/><TextBox x:Name="tb_hook" Grid.Column="2" Text="12"/></Grid>
<TextBlock Text="ช่องขวา = จำนวนเท่าของ d เมื่อเลือก กำหนดเอง" FontSize="10" Foreground="{StaticResource TxtDim}"/>
<TextBlock Text="ต่อทาบ (คานยาว)" FontSize="11.5" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,14,0,6"/>
<Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <TextBlock Text="ความยาวเหล็กสูงสุดต่อท่อน (ม.)" VerticalAlignment="Center"/>
  <TextBox x:Name="tb_maxlen" Grid.Column="1" Text="10" HorizontalAlignment="Left"/></Grid>
<Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <TextBlock Text="ระยะทาบ (× d)" VerticalAlignment="Center"/>
  <TextBox x:Name="tb_lap" Grid.Column="1" Text="40" HorizontalAlignment="Left"/></Grid>
<TextBlock Text="ระยะหุ้ม" FontSize="11.5" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,14,0,6"/>
<Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <TextBlock Text="ระยะหุ้ม (ม. ถึงผิวปลอก)" VerticalAlignment="Center"/>
  <TextBox x:Name="tb_cover" Grid.Column="1" Text="0.025" HorizontalAlignment="Left"/></Grid>
<TextBlock Text="ด่านตรวจก่อนสร้าง" FontSize="11.5" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,14,0,6"/>
<TextBlock x:Name="tb_check" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,4"/>
