<TextBlock x:Name="tb_info" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TxtDim}"/>
<CheckBox x:Name="cb_same" Content="ใส่ให้คานชื่อ type เดียวกันทั้งอาคาร" IsChecked="False"/>
<CheckBox x:Name="cb_replace" Content="แทนที่เหล็ก REVOTECH เดิมของคานเหล่านี้" IsChecked="True"/>
<TextBlock Text="เหล็กบน (จำนวน × ขนาด)" FontSize="11.5" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,14,0,6"/>
<Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <TextBlock Text="ชั้นที่ 1" VerticalAlignment="Center"/>
  <ComboBox x:Name="cmb_top1_n" Grid.Column="1" Height="26" Margin="0,0,6,0"/>
  <ComboBox x:Name="cmb_top1_d" Grid.Column="2" Height="26"/></Grid>
<Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
