  <ComboBox x:Name="cmb_xtop_d" Grid.Column="2" Height="26"/></Grid>
<Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
  <TextBlock Text="  ตำแหน่ง / L÷" VerticalAlignment="Center"/>
  <ComboBox x:Name="cmb_xtop_pos" Grid.Column="1" Height="26" Margin="0,0,6,0"/>
  <ComboBox x:Name="cmb_xtop_div" Grid.Column="2" Height="26"/></Grid>
<Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <TextBlock Text="เสริมล่าง" VerticalAlignment="Center"/>
  <ComboBox x:Name="cmb_xbot_n" Grid.Column="1" Height="26" Margin="0,0,6,0"/>
  <ComboBox x:Name="cmb_xbot_d" Grid.Column="2" Height="26"/></Grid>
<Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
