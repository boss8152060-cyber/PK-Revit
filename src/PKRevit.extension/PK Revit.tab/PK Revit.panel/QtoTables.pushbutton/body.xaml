<TextBlock x:Name="tb_info" FontSize="12" TextWrapping="Wrap"
           Foreground="{StaticResource TxtDim}"/>

<TextBlock Text="โครงหลังคา (Structural Framing ตามชื่อ type)" FontSize="11.5"
           Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,12,0,6"/>
<StackPanel x:Name="tbl_frame"/>

<TextBlock Text="วัสดุมุง (Roof Cover)" FontSize="11.5"
           Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,14,0,6"/>
<StackPanel x:Name="tbl_cover"/>

<TextBlock x:Name="tb_note" FontSize="10.5" Foreground="#111111" FontWeight="SemiBold" TextWrapping="Wrap"
           Margin="0,8,0,0"/>

<TextBlock Text="ผลลัพธ์" FontSize="11.5" Foreground="{StaticResource Accent}"
           FontWeight="SemiBold" Margin="0,14,0,6"/>
<CheckBox x:Name="cb_sched" Content="สร้าง Schedule ใน Revit (โครงหลังคา + ชิ้นวัสดุมุง)" IsChecked="True"/>
<CheckBox x:Name="cb_csv" Content="ส่งออก CSV (UTF-8 BOM) ลง %LOCALAPPDATA%\PKRevit" IsChecked="True" Margin="0,6,0,0"/>
