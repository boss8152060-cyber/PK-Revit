<TextBlock x:Name="tb_info" FontSize="12" TextWrapping="Wrap"
           Foreground="{StaticResource TxtDim}"/>
<CheckBox x:Name="cb_same" Content="ใส่ให้ฐานรากชื่อ type เดียวกันทั้งอาคาร" IsChecked="False"/>
<CheckBox x:Name="cb_replace" Content="แทนที่เหล็ก PK Revit เดิมของฐานรากเหล่านี้" IsChecked="True"/>

<StackPanel x:Name="sp_rect">
    <TextBlock Text="ตะแกรงเหล็กล่าง — ฐานสี่เหลี่ยม (F1P / F2 / F4)" FontSize="11.5"
               Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,14,0,6"/>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="ตามด้านยาว  ขนาด / เส้น" VerticalAlignment="Center"/>
        <ComboBox x:Name="cmb_long" Grid.Row="0" Grid.Column="1" Height="26" Margin="0,0,6,6"/>
        <TextBox x:Name="tb_long_n" Grid.Row="0" Grid.Column="2" Text="4" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Text="ตามด้านสั้น  ขนาด / เส้น" VerticalAlignment="Center"/>
        <ComboBox x:Name="cmb_short" Grid.Row="1" Grid.Column="1" Height="26" Margin="0,0,6,0"/>
        <TextBox x:Name="tb_short_n" Grid.Row="1" Grid.Column="2" Text="4"/>
    </Grid>
    <TextBlock Text="“ตามด้านยาว” = เหล็กวิ่งขนานด้านยาว กระจายตลอดความกว้างฐาน (ชั้นล่างสุด) — ตีความเอง รอยืนยัน"
               FontSize="10" Foreground="{StaticResource TxtDim}" TextWrapping="Wrap" Margin="0,4,0,0"/>
</StackPanel>

<StackPanel x:Name="sp_tri">
    <TextBlock Text="ตะแกรงเหล็กล่าง — ฐานสามเหลี่ยม 3 เสาเข็ม (3 ทิศ)" FontSize="11.5"
               Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,14,0,6"/>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="ทิศ 0°  ขนาด / เส้น" VerticalAlignment="Center"/>
        <ComboBox x:Name="cmb_t0" Grid.Row="0" Grid.Column="1" Height="26" Margin="0,0,6,6"/>
        <TextBox x:Name="tb_t0_n" Grid.Row="0" Grid.Column="2" Text="3" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Text="ทิศ 60°  ขนาด / เส้น" VerticalAlignment="Center"/>
        <ComboBox x:Name="cmb_t60" Grid.Row="1" Grid.Column="1" Height="26" Margin="0,0,6,6"/>
        <TextBox x:Name="tb_t60_n" Grid.Row="1" Grid.Column="2" Text="3" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="2" Text="ทิศ 120°  ขนาด / เส้น" VerticalAlignment="Center"/>
        <ComboBox x:Name="cmb_t120" Grid.Row="2" Grid.Column="1" Height="26" Margin="0,0,6,0"/>
        <TextBox x:Name="tb_t120_n" Grid.Row="2" Grid.Column="2" Text="3"/>
    </Grid>
    <TextBlock Text="มุมวัดจากแกน X ของฐานราก (local) ทวนเข็ม; ทิศ 0° อยู่ชั้นล่างสุด ตามด้วย 60° และ 120°"
               FontSize="10" Foreground="{StaticResource TxtDim}" TextWrapping="Wrap" Margin="0,4,0,0"/>
</StackPanel>

<TextBlock Text="รูปแบบตะขอ (เลือก 1)" FontSize="11.5" Foreground="{StaticResource Accent}"
           FontWeight="SemiBold" Margin="0,14,0,6"/>
<StackPanel>
    <RadioButton x:Name="rb_h1" GroupName="hook" Content="งอขึ้น 90° ปลายยาว 12d"/>
    <RadioButton x:Name="rb_h2" GroupName="hook" Content="งอขึ้น 90° ยาวถึงใต้ระยะหุ้มบน"/>
    <RadioButton x:Name="rb_h3" GroupName="hook" Content="เหล็กตรง ไม่งอ"/>
</StackPanel>

<TextBlock Text="เหล็กรัดรอบ (ไม่บังคับ)" FontSize="11.5" Foreground="{StaticResource Accent}"
           FontWeight="SemiBold" Margin="0,14,0,6"/>
<CheckBox x:Name="cb_ring" Content="ใส่เหล็กรัดรอบ" IsChecked="False"/>
<Grid Margin="0,6,0,0">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="ขนาด" VerticalAlignment="Center"/>
    <ComboBox x:Name="cmb_ring" Grid.Row="0" Grid.Column="1" Height="26" Margin="0,0,0,6"/>
    <TextBlock Grid.Row="1" Text="จำนวน (วง)" VerticalAlignment="Center"/>
    <TextBox x:Name="tb_ring_n" Grid.Row="1" Grid.Column="1" Text="1" HorizontalAlignment="Left" Margin="0,0,0,6"/>
    <TextBlock Grid.Row="2" Text="ระยะห่าง (ม.)" VerticalAlignment="Center"/>
    <TextBox x:Name="tb_ring_sp" Grid.Row="2" Grid.Column="1" Text="0.15" HorizontalAlignment="Left"/>
</Grid>

<TextBlock Text="ระยะหุ้ม" FontSize="11.5" Foreground="{StaticResource Accent}"
           FontWeight="SemiBold" Margin="0,14,0,6"/>
<StackPanel Orientation="Horizontal">
    <TextBox x:Name="tb_cover" Text="0.075"/>
    <TextBlock Text="  ม. (ถึงผิวเหล็กนอกสุด)" VerticalAlignment="Center" Foreground="{StaticResource TxtDim}"/>
</StackPanel>

<TextBlock Text="รูปเหล็ก / ตะขอ / ต่อทาบ" FontSize="11.5" Foreground="{StaticResource Accent}"
           FontWeight="SemiBold" Margin="0,14,0,6"/>
<Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="Rebar Shape เหล็กหลัก" VerticalAlignment="Center"/>
    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" x:Name="cmb_shape_main" Height="26"/>
    <TextBlock Grid.Row="1" Text="Rebar Shape ปลอก/เหล็กรัด" VerticalAlignment="Center"/>
    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" x:Name="cmb_shape_tie" Height="26"/>
</Grid>
<TextBlock Text="เลือก Rebar Shape = สร้างจากรูปเหล็กในโปรเจกต์ (ฐานรากใช้ตัวเลือกตะขอเดิมของฟอร์มในโหมดอัตโนมัติ)" FontSize="10" Foreground="{StaticResource TxtDim}" TextWrapping="Wrap" Margin="0,2,0,0"/>

<TextBlock Text="ด่านตรวจก่อนสร้าง" FontSize="11.5" Foreground="{StaticResource Accent}"
           FontWeight="SemiBold" Margin="0,14,0,6"/>
<TextBlock x:Name="tb_check" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,4"/>
