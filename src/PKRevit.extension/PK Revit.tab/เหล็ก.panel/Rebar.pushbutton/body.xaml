<StackPanel>
<StackPanel.Resources>
    <Style x:Key="PkBig" TargetType="Button">
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{StaticResource Field}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="9" Padding="16,11">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="BorderBrush" Value="#111111"/>
                            <Setter TargetName="bg" Property="Background" Value="#EDEDED"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#DDDDDD"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</StackPanel.Resources>
<TextBlock x:Name="tb_info" FontSize="12" TextWrapping="Wrap"
           Foreground="{StaticResource TxtDim}" Margin="0,0,0,10"/>
<Button x:Name="hub_column" Style="{StaticResource PkBig}">
    <StackPanel>
        <TextBlock Text="เสา" FontSize="16" FontWeight="Bold"/>
        <TextBlock Text="เหล็กยืน + ปลอก — เลือกเสาได้หลายต้น" FontSize="11.5" Foreground="{StaticResource TxtDim}"
                   TextWrapping="Wrap" Margin="0,2,0,0"/>
    </StackPanel>
</Button>
<Button x:Name="hub_beam" Style="{StaticResource PkBig}">
    <StackPanel>
        <TextBlock Text="คาน" FontSize="16" FontWeight="Bold"/>
        <TextBlock Text="เหล็กบน/ล่าง/ปลอก/เหล็กข้าง" FontSize="11.5" Foreground="{StaticResource TxtDim}"
                   TextWrapping="Wrap" Margin="0,2,0,0"/>
    </StackPanel>
</Button>
<Button x:Name="hub_footing" Style="{StaticResource PkBig}">
    <StackPanel>
        <TextBlock Text="ฐานราก" FontSize="16" FontWeight="Bold"/>
        <TextBlock Text="เหล็กตะแกรงล่าง/บน ตามรูปฐานราก" FontSize="11.5" Foreground="{StaticResource TxtDim}"
                   TextWrapping="Wrap" Margin="0,2,0,0"/>
    </StackPanel>
</Button>
<Button x:Name="hub_slab" Style="{StaticResource PkBig}">
    <StackPanel>
        <TextBlock Text="พื้น" FontSize="16" FontWeight="Bold"/>
        <TextBlock Text="เหล็กเส้น หรือ ตะแกรงสำเร็จรูป (Fabric)" FontSize="11.5" Foreground="{StaticResource TxtDim}"
                   TextWrapping="Wrap" Margin="0,2,0,0"/>
    </StackPanel>
</Button>
<Button x:Name="hub_stair" Style="{StaticResource PkBig}">
    <StackPanel>
        <TextBlock Text="บันได" FontSize="16" FontWeight="Bold"/>
        <TextBlock Text="เหล็กหลัก ชาน ลูกนอน-ลูกตั้ง" FontSize="11.5" Foreground="{StaticResource TxtDim}"
                   TextWrapping="Wrap" Margin="0,2,0,0"/>
    </StackPanel>
</Button>
<Border Height="14"/>
</StackPanel>
